# Copy these into Vercel → Project → Settings → Environment Variables.
# None of them starts with NEXT_PUBLIC_, so none ever reaches the browser.
# Never commit a real .env file.

# --- Required ---
ANTHROPIC_API_KEY=            # Claude API key (console.anthropic.com), any Anthropic account
SUPABASE_URL=                 # the helpdesk's OWN Supabase project, not the evaluation app's
SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Project Settings → API → service_role / secret key
SESSION_SECRET=               # 32+ random characters: run  openssl rand -base64 48
OWNER_PASSWORD=               # 12+ characters, for you
APP_URL=                      # e.g. https://parthu-helpdesk.vercel.app

# --- Developer (person running the evaluation app's Claude Code) ---
DEVELOPER_PASSWORD=           # 12+ characters; lets them open the Fixes page only

# --- Email alerts (optional, via resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. Parthu Helpdesk <helpdesk@yourdomain.com>
OWNER_EMAILS=                 # new change waiting for your review (comma separated)
DEVELOPER_EMAILS=             # fix approved, ready for Claude Code (comma separated)

# --- GitHub issues (optional) ---
GITHUB_ISSUES_TOKEN=          # fine-grained token: ONE repo, permission "Issues: read and write" only
GITHUB_REPO=                  # owner/name of the evaluation app's repository
GITHUB_MENTION_CLAUDE=false   # true = add @claude so the Claude GitHub App starts the fix itself

# --- Marks data from the evaluation app (optional) ---
INTEGRATION_TOKEN=            # 32+ random characters, shared only with the evaluation app's server

# --- Tuning (optional) ---
CLAUDE_MODEL=claude-opus-5-5
TEACHER_HOURLY_LIMIT=30
EMBED_ORIGINS=                # sites allowed to show the helpdesk in an iframe, space separated
