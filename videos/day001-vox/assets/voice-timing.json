 "phrases": [
  {
   "start": 0.1,
   "end": 2.3,
   "text": "हर महीने पंद्रह parents पूछने आते हैं,"
  },
  {
   "start": 2.75,
   "end": 4.5,
   "text": "और admission लेते हैं सिर्फ़ तीन?"
  },
  {
   "start": 4.9,
   "end": 6.25,
   "text": "हर enquiry अलग होती है —"
  },
  {
   "start": 6.5,
   "end": 7.55,
   "text": "Hot, Warm, या Cold।"
  },
  {
   "start": 8.0,
   "end": 9.7,
   "text": "पहले call पे fees बताने से पहले,"
  },
  {
   "start": 10.2,
   "end": 11.55,
   "text": "सिर्फ़ तीन सवाल पूछो।"
  },
  {
   "start": 12.4,
   "end": 12.6,
   "text": "एक:"
  },
  {
   "start": 13.1,
   "end": 14.5,
   "text": "“कब से join करना चाहते हैं?”"
  },
  {
   "start": 15.45,
   "end": 17.55,
   "text": "दो: “बच्चे को अभी किस चीज़ में दिक्कत है?”"
  },
  {
   "start": 18.35,
   "end": 18.65,
   "text": "तीन:"
  },
  {
   "start": 19.2,
   "end": 20.95,
   "text": "“क्या आप इस हफ़्ते centre आ सकते हैं?”"
  },
  {
   "start": 21.35,
   "end": 21.65,
   "text": "Hot:"
  },
  {
   "start": 22.0,
   "end": 23.5,
   "text": "दो हफ़्ते में join करना है,"
  },
  {
   "start": 23.7,
   "end": 25.3,
   "text": "और centre आने के लिए हाँ बोला।"
  },
  {
   "start": 25.7,
   "end": 27.45,
   "text": "Hot enquiry को phone पे सब मत बताओ।"
  },
  {
   "start": 27.85,
   "end": 28.15,
   "text": "कहो:"
  },
  {
   "start": 28.65,
   "end": 30.75,
   "text": "“आज या कल शाम बच्चे के साथ आ जाइए,"
  },
  {
   "start": 31.05,
   "end": 32.55,
   "text": "दस मिनट में सब समझा दूँगा।”"
  },
  {
   "start": 32.9,
   "end": 33.9,
   "text": "और जाने से पहले"
  },
  {
   "start": 34.1,
   "end": 35.3,
   "text": "अगला step fix करो —"
  },
  {
   "start": 35.95,
   "end": 36.95,
   "text": "trial की date।"
  },
  {
   "start": 37.3,
   "end": 38.1,
   "text": "Track कैसे करें?"
  },
  {
   "start": 38.5,
   "end": 39.6,
   "text": "Number ऐसे save करो:"
  },
  {
   "start": 40.05,
   "end": 41.1,
   "text": "“H Rohan 9th”"
  },
  {
   "start": 41.4,
   "end": 42.15,
   "text": "Admission हो गया?"
  },
  {
   "start": 42.85,
   "end": 44.05,
   "text": "ADM लिख दो।"
  },
  {
   "start": 44.5,
   "end": 45.2,
   "text": "तो याद रखो —"
  },
  {
   "start": 45.55,
   "end": 46.45,
   "text": "तीन सवाल पूछो,"
  },
  {
   "start": 46.95,
   "end": 48.35,
   "text": "Hot-Warm-Cold में बाँटो,"
  },
  {
   "start": 48.75,
   "end": 50.9,
   "text": "और हर एक को अलग follow-up दो।"
  },
  {
   "start": 51.2,
   "end": 52.0,
   "text": "Admission आ गए,"
  },
  {
   "start": 52.45,
   "end": 54.3,
   "text": "अब fees time पे कैसे आए?"
  },
  {
   "start": 54.65,
   "end": 55.2,
   "text": "Day 2 में।"
  },
  {
   "start": 55.45,
   "end": 56.0,
   "text": "Follow कर लो।"
  }
 ],
