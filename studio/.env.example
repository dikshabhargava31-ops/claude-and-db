# Creator Research Studio — server settings. Copy to studio/.env (git-ignored) and fill in what you have.
# Every key stays on the server; none of them is ever sent to the browser.

# --- Server ---
PORT=4317
# 127.0.0.1 keeps the app private to this computer. Use 0.0.0.0 only behind HTTPS on a private host.
HOST=127.0.0.1
# The address people use to open the app. Needed for Google sign-in; https:// also turns on secure cookies.
PUBLIC_URL=http://localhost:4317
# DATA_DIR=data

# --- Database (only for publishing online; see README → Publish on Vercel) ---
# Supabase → Project Settings → API keys: the Project URL and a secret / service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hosted app only: the one email allowed to create the owner account, and a random secret for the daily cron job.
# OWNER_EMAIL=
# CRON_SECRET=

# --- YouTube Data API (public videos, channels, search) — free, 10,000 units/day ---
YOUTUBE_API_KEY=

# --- YouTube Analytics + Reporting (your own channel, read-only OAuth) — free ---
# Redirect URI to register in Google Cloud: <PUBLIC_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude API (AI research, topics, hooks, scripts, assistant) — paid per use ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Instagram Planner bridge (your existing scheduler in this repository) ---
# Reading the planner works without a token. Sending an APPROVED post needs a fine-grained token
# for dikshabhargava31-ops/claude-and-db with Contents: read and write (and Actions: read and write
# to start a scheduler run, optional).
GITHUB_TOKEN=
# IG_PLANNER_REPO=dikshabhargava31-ops/claude-and-db
# IG_PLANNER_BRANCH=main

# --- Instagram insights (optional) ---
# JSON: {"ipa": {"user_id": "1784...", "token": "IGAA..."}} — tokens need instagram_business_manage_insights.
IG_INSIGHTS_ACCOUNTS=
