 "rules": {
  "source": "https://cdnbbsr.s3waas.gov.in/s3d1a21da7bca4abff8b0b61b87597de73/uploads/2026/01/202601031633478370.pdf",
  "rows": [
   {
    "area": "Application",
    "rule": "Only one application per candidate; multiple applications lead to cancellation"
   },
   {
    "area": "Application",
    "rule": "One mobile number and one email per application"
   },
   {
    "area": "Application",
    "rule": "Details entered (name, DOB, category, PwD status, city choices) cannot be changed by NTA after submission; no corrections by post, fax, WhatsApp, email or hand"
   },
   {
    "area": "Fees",
    "rule": "Fee non-refundable once paid; duplicate payments reconciled and refunded"
   },
   {
    "area": "Uploads",
    "rule": "Photo: colour, recent, 80% face incl. ears, no mask, light background, JPG 10–200 KB (+ live photo capture)"
   },
   {
    "area": "Uploads",
    "rule": "Signature: JPG 10–50 KB; PwD/UDID certificate: PDF 50–300 KB; ID proof (if not Aadhaar/DigiLocker): JPG 10–200 KB"
   },
   {
    "area": "Exam day",
    "rule": "Report at least 2 hours before reporting time"
   },
   {
    "area": "Exam day",
    "rule": "Carry printed admit card with self-declaration (A4), one passport photo, original valid photo ID, PwD certificate if applicable, transparent ball-point pen"
   },
   {
    "area": "Exam day",
    "rule": "Prohibited: phones, watches, calculators, bags, stationery, food, water, metallic items; slippers or low-heeled sandals only"
   },
   {
    "area": "Conduct",
    "rule": "Unfair means: result cancellation, debarment up to 3 years, possible criminal action"
   },
   {
    "area": "Results",
    "rule": "No re-test for missed exams; no re-evaluation or re-checking"
   },
   {
    "area": "Results",
    "rule": "NTA Score valid only for 2026–27; results shared with universities, candidates must follow each university's admission process"
   },
   {
    "area": "Records",
    "rule": "NTA keeps exam records for 90 days after result"
   },
   {
    "area": "Account",
    "rule": "Password 8–13 characters with uppercase, lowercase, number and special character"
   },
   {
    "area": "Admission",
    "rule": "Appearing in CUET does not guarantee admission; candidates must meet each university's programme-wise eligibility"
   }
  ]
